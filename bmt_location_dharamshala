<p>    document.getElementById('bmt-next-month').addEventListener('click', () => {<br />
      this.currentMonth.setMonth(this.currentMonth.getMonth() + 1);<br />
      this.updateCalendar();<br />
    });</p>
<p>    // Time slot selection<br />
    document.getElementById('bmt-time-slots').addEventListener('click', (e) => {<br />
      if (e.target.classList.contains('bmt-time-slot')) {<br />
        document.querySelectorAll('.bmt-time-slot').forEach(slot => slot.classList.remove('selected'));<br />
        e.target.classList.add('selected');<br />
        this.selectedTime = e.target.dataset.time;<br />
        this.updateBookingState();<br />
      }<br />
    });</p>
<p>    // Package selection<br />
    document.getElementById('bmt-package-grid').addEventListener('click', (e) => {<br />
      const packageCard = e.target.closest('.bmt-package-card');<br />
      if (packageCard) {<br />
        document.querySelectorAll('.bmt-package-card').forEach(card => card.classList.remove('selected'));<br />
        packageCard.classList.add('selected');<br />
        this.selectedPackage = packageCard.dataset.package;<br />
        this.updateBookingState();<br />
      }<br />
    });</p>
<p>    // Package keyboard navigation<br />
    document.getElementById('bmt-package-grid').addEventListener('keydown', (e) => {<br />
      if (e.key === 'Enter' || e.key === ' ') {<br />
        e.preventDefault();<br />
        const packageCard = e.target.closest('.bmt-package-card');<br />
        if (packageCard) {<br />
          packageCard.click();<br />
        }<br />
      }<br />
    });</p>
<p>    // Person selector<br />
    document.getElementById('bmt-decrease-persons').addEventListener('click', () => {<br />
      if (this.personCount > 1) {<br />
        this.personCount--;<br />
        this.updatePersonCount();<br />
        this.updateBookingState();<br />
      }<br />
    });</p>
<p>    document.getElementById('bmt-increase-persons').addEventListener('click', () => {<br />
      this.personCount++;<br />
      this.updatePersonCount();<br />
      this.updateBookingState();<br />
    });</p>
<p>    // Mobile person selector<br />
    document.getElementById('bmt-mobile-decrease-persons').addEventListener('click', () => {<br />
