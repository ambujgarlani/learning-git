    });</p>
<p>    // Book now buttons<br />
    // ---- REPLACED bookNowHandler START ----<br />
    // This handler will POST to WC AJAX add_to_cart with bmt_booking JSON and fallback to redirect.<br />
    const WC_PRODUCT_ID = 1144; // <-- your Paragliding product ID

    const bookNowHandler = async (e) => {<br />
      if (!(this.selectedDate && this.selectedTime && this.selectedPackage)) {<br />
        alert('Please select date, time and package before proceeding.');<br />
        return;<br />
      }</p>
<p>      const selectedPkg = PACKAGES.find(pkg => pkg.id === this.selectedPackage);<br />
      const booking = {<br />
        product_name: 'Paragliding in Dharamshala',<br />
        source: 'paragliding-in-dharamshala-widget',<br />
        date: this.selectedDate,<br />
        time: this.selectedTime,<br />
        package_id: this.selectedPackage,<br />
        package_name: selectedPkg ? selectedPkg.name : this.selectedPackage,<br />
        unit_price: selectedPkg ? selectedPkg.price : 0, // per person<br />
        persons: this.personCount || 1,<br />
      };<br />
      booking.total_price = (booking.unit_price || 0) * Math.max(1, booking.persons);</p>
<p>      // Build form data for WC AJAX<br />
      const form = new FormData();<br />
      form.append('product_id', String(WC_PRODUCT_ID));<br />
      // send quantity as persons (PHP will handle price override)<br />
      form.append('quantity', String(Math.max(1, booking.persons)));<br />
      form.append('bmt_booking', JSON.stringify(booking));<br />
      form.append('bmt_source', booking.source);</p>
<p>      try {<br />
        const resp = await fetch('/?wc-ajax=add_to_cart', {<br />
          method: 'POST',<br />
          credentials: 'same-origin',<br />
          body: form<br />
        });</p>
<p>        if (resp && resp.ok) {<br />
          // success — redirect to checkout with booking query string (keeps UX consistent)<br />
          const qs = new URLSearchParams({<br />
            date: booking.date,<br />
            time: booking.time,<br />
            package: booking.package_name,<br />
            price: String(booking.total_price),<br />
            persons: String(booking.persons)<br />
          }).toString();</p>
<p>          window.location.href = `${CART_URL}?${qs}`;<br />
          return;<br />
        }<br />
      } catch (err) {<br />
        console.warn('Add to cart via AJAX failed:', err);<br />
      }</p>
<p>      // fallback redirect (if AJAX blocked)<br />
      const fallbackQS = new URLSearchParams({<br />
        date: booking.date,<br />
        time: booking.time,<br />
        package: booking.package_name,<br />
        price: String(booking.total_price),<br />
        persons: String(booking.persons)<br />
      }).toString();</p>
<p>      window.location.href = `${CART_URL}?${fallbackQS}`;<br />
    };<br />
    // ---- REPLACED bookNowHandler END ----</p>
<p>    document.getElementById('bmt-book-now').addEventListener('click', bookNowHandler);<br />
    document.getElementById('bmt-mobile-book-now').addEventListener('click', bookNowHandler);<br />
  }</p>
<p>    updateCalendar() {<br />
    const monthYear = document.getElementById('bmt-month-year');<br />
    const calendarGrid = document.getElementById('bmt-calendar-grid');</p>
<p>    // Update month/year display<br />
    const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',<br />
      'July', 'August', 'September', 'October', 'November', 'December'];<br />
    monthYear.textContent = `${monthNames[this.currentMonth.getMonth()]} ${this.currentMonth.getFullYear()}`;</p>
<p>    // Clear existing days (keep headers)<br />
    const dayButtons = calendarGrid.querySelectorAll('.bmt-day-button');<br />
    dayButtons.forEach(btn => btn.remove());</p>
<p>    // Get first day of month and number of days<br />
    const firstDay = new Date(this.currentMonth.getFullYear(), this.currentMonth.getMonth(), 1);<br />
    const lastDay = new Date(this.currentMonth.getFullYear(), this.currentMonth.getMonth() + 1, 0);<br />
    const startDate = firstDay.getDay(); // 0 = Sunday<br />
    const daysInMonth = lastDay.getDate();</p>
<p>    // Add empty cells for days before month starts<br />
    for (let i = 0; i < startDate; i++) {
      const emptyDay = document.createElement('div');
      calendarGrid.appendChild(emptyDay);
    }

    // Compute "today" at midnight for reliable comparisons (local timezone)
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()); // midnight today

    // Add day buttons
    for (let day = 1; day <= daysInMonth; day++) {
      const dayButton = document.createElement('button');
      dayButton.className = 'bmt-day-button';
      dayButton.textContent = day;
      dayButton.setAttribute('aria-label', `Select ${day} ${monthNames[this.currentMonth.getMonth()]} ${this.currentMonth.getFullYear()}`);

      // Build the full date for this cell (midnight)
      const cellDate = new Date(this.currentMonth.getFullYear(), this.currentMonth.getMonth(), day);

      // If cellDate is before today -> disable it (past date)<br />
      if (cellDate < today) {
        dayButton.disabled = true;
        // Optional: add a class if you want a specific style for disabled days
        dayButton.classList.add('disabled');
      } else {
        // available or future dates
        dayButton.classList.add('available');
      }

      // If the currently-selected date is now in the past, clear it
      if (this.selectedDate) {
        // selectedDate is stored like "30 October 2025" in widget -> attempt to parse<br />
        const selParts = String(this.selectedDate).trim().split(' ');<br />
        // Expect format: [day, Month, Year] or maybe different – handle gracefully<br />
        if (selParts.length >= 3) {<br />
          const selDay = parseInt(selParts[0], 10);<br />
          const selMonthName = selParts[1];<br />
          const selYear = parseInt(selParts[2], 10);<br />
          const selMonthIndex = monthNames.findIndex(m => m.toLowerCase() === selMonthName.toLowerCase());<br />
          if (!Number.isNaN(selDay) && selMonthIndex >= 0 && !Number.isNaN(selYear)) {<br />
            const selectedDateObj = new Date(selYear, selMonthIndex, selDay);<br />
            if (selectedDateObj < today) {
              // clear invalid selection
              this.selectedDate = null;
              // also remove any selected class visually
              document.querySelectorAll('.bmt-day-button.selected').forEach(s => s.classList.remove('selected'));<br />
              // ensure booking state updates<br />
              this.updateBookingState();<br />
            }<br />
          }<br />
        }<br />
      }</p>
<p>      // Handle day selection (only for enabled days)<br />
      dayButton.addEventListener('click', () => {<br />
        if (!dayButton.disabled) {<br />
          document.querySelectorAll('.bmt-day-button').forEach(btn => btn.classList.remove('selected'));<br />
          dayButton.classList.add('selected');<br />
          this.selectedDate = `${day} ${monthNames[this.currentMonth.getMonth()]} ${this.currentMonth.getFullYear()}`;<br />
          this.updateBookingState();<br />
        }<br />
      });</p>
<p>      calendarGrid.appendChild(dayButton);<br />
    }<br />
  }</p>
<p>  updatePersonCount() {<br />
    document.getElementById('bmt-person-count').textContent = this.personCount;<br />
    document.getElementById('bmt-mobile-person-count').textContent = this.personCount;</p>
<p>    // Disable decrease buttons if at minimum<br />
    const decreaseBtn = document.getElementById('bmt-decrease-persons');<br />
    const mobileDecreaseBtn = document.getElementById('bmt-mobile-decrease-persons');<br />
    decreaseBtn.disabled = this.personCount <= 1;
    mobileDecreaseBtn.disabled = this.personCount <= 1;
  }

  updateBookingState() {
    // Update summary
    document.getElementById('bmt-summary-date').textContent = this.selectedDate || 'Not selected';
    document.getElementById('bmt-summary-time').textContent = this.selectedTime || 'Not selected';
    
    let packageName = 'Not selected';
    let packagePrice = 0;
    let originalPrice = 0;
    let savings = 0;
    
    if (this.selectedPackage) {
      const selectedPkg = PACKAGES.find(pkg => pkg.id === this.selectedPackage);<br />
      packageName = selectedPkg.name;<br />
      packagePrice = selectedPkg.price * this.personCount;<br />
      originalPrice = selectedPkg.originalPrice * this.personCount;<br />
      savings = originalPrice - packagePrice;<br />
    }</p>
<p>    document.getElementById('bmt-summary-package').textContent = packageName;<br />
    document.getElementById('bmt-summary-price').textContent = `₹${packagePrice.toLocaleString()}`;</p>
<p>    // Update savings info<br />
    const savingsInfo = document.getElementById('bmt-savings-info');<br />
    const mobileSavingsInfo = document.getElementById('bmt-mobile-savings-info');<br />
    if (this.selectedPackage && savings > 0) {<br />
      document.getElementById('bmt-savings-amount').textContent = `You save ₹${savings.toLocaleString()}`;<br />
      document.getElementById('bmt-original-price').textContent = `₹${originalPrice.toLocaleString()}`;<br />
      document.getElementById('bmt-mobile-savings-amount').textContent = `You save ₹${savings.toLocaleString()}`;<br />
      document.getElementById('bmt-mobile-original-price').textContent = `₹${originalPrice.toLocaleString()}`;<br />
      savingsInfo.style.display = 'block';<br />
      mobileSavingsInfo.style.display = 'block';<br />
    } else {<br />
      savingsInfo.style.display = 'none';<br />
      mobileSavingsInfo.style.display = 'none';<br />
    }</p>
<p>    // Update mobile bar<br />
    const mobileDetails = document.getElementById('bmt-mobile-details');<br />
    const mobilePrice = document.getElementById('bmt-mobile-price');</p>
<p>    if (this.selectedDate && this.selectedPackage) {<br />
      const personText = this.personCount > 1 ? ` • ${this.personCount} persons` : '';<br />
      mobileDetails.textContent = `${this.selectedDate.split(' ')[0]} ${this.selectedDate.split(' ')[1]} • ${packageName.split(' ')[0]}${personText}`;<br />
      mobilePrice.textContent = `₹${packagePrice.toLocaleString()}`;<br />
    } else {<br />
      mobileDetails.textContent = 'Select date & package';<br />
      mobilePrice.textContent = '₹0';<br />
    }</p>
<p>    // Enable/disable book now buttons<br />
    const canBook = this.selectedDate && this.selectedTime && this.selectedPackage;<br />
    document.getElementById('bmt-book-now').disabled = !canBook;<br />
    document.getElementById('bmt-mobile-book-now').disabled = !canBook;<br />
  }<br />
}</p>
