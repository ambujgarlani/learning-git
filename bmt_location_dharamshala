<p>  bindEvents() {<br />
    // Calendar navigation<br />
    document.getElementById('bmt-prev-month').addEventListener('click', () => {<br />
      this.currentMonth.setMonth(this.currentMonth.getMonth() - 1);<br />
      this.updateCalendar();<br />
