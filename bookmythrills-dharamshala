<p>      // Book now buttons<br />
      // ---- REPLACED bookNowHandler START ----<br />
      // This handler will POST to WC AJAX add_to_cart with bmt_booking JSON and fallback to redirect.<br />
      const WC_PRODUCT_ID = 1571; // <-- your Paragliding product ID

      const bookNowHandler = async (e) => {<br />
        if (!(this.selectedDate && this.selectedTime && this.selectedPackage)) {<br />
          alert("Please select date, time and package before proceeding.");<br />
          return;<br />
        }</p>
<p>        const selectedPkg = PACKAGES.find(<br />
          (pkg) => pkg.id === this.selectedPackage,<br />
