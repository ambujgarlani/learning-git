<p>      if (this.selectedDate && this.selectedPackage) {<br />
        const personText =<br />
          this.personCount > 1 ? ` • ${this.personCount} persons` : "";<br />
        mobileDetails.textContent = `${this.selectedDate.split(" ")[0]} ${this.selectedDate.split(" ")[1]} • ${packageName.split(" ")[0]}${personText}`;<br />
        mobilePrice.textContent = `₹${packagePrice.toLocaleString()}`;<br />
      } else {<br />
        mobileDetails.textContent = "Select date & package";<br />
        mobilePrice.textContent = "₹0";<br />
      }</p>
<p>      // Enable/disable book now buttons<br />
      const canBook =<br />
        this.selectedDate && this.selectedTime && this.selectedPackage;<br />
      document.getElementById("bmt-book-now").disabled = !canBook;<br />
      document.getElementById("bmt-mobile-book-now").disabled = !canBook;<br />
    }<br />
    // ===== FEATURE END: Person count controls and pricing sync =====<br />
  }</p>
<p>  // ===== FEATURE END: Event bindings =====<br />
