        .addEventListener("click", bookNowHandler);<br />
      document<br />
        .getElementById("bmt-mobile-book-now")<br />
        .addEventListener("click", bookNowHandler);<br />
    }</p>
<p>    updateCalendar() {<br />
      const monthYear = document.getElementById("bmt-month-year");<br />
      const calendarGrid = document.getElementById("bmt-calendar-grid");</p>
<p>      // Update month/year display<br />
      const monthNames = [<br />
        "January",<br />
        "February",<br />
        "March",<br />
        "April",<br />
        "May",<br />
        "June",<br />
        "July",<br />
        "August",<br />
        "September",<br />
        "October",<br />
        "November",<br />
        "December",<br />
      ];<br />
      monthYear.textContent = `${monthNames[this.currentMonth.getMonth()]} ${this.currentMonth.getFullYear()}`;</p>
<p>      // Clear existing days (keep headers)<br />
      const dayButtons = calendarGrid.querySelectorAll(".bmt-day-button");<br />
      dayButtons.forEach((btn) => btn.remove());</p>
<p>      // Get first day of month and number of days<br />
      const firstDay = new Date(<br />
        this.currentMonth.getFullYear(),<br />
        this.currentMonth.getMonth(),<br />
        1,<br />
      );<br />
      const lastDay = new Date(<br />
        this.currentMonth.getFullYear(),<br />
        this.currentMonth.getMonth() + 1,<br />
        0,<br />
      );<br />
      const startDate = firstDay.getDay(); // 0 = Sunday<br />
      const daysInMonth = lastDay.getDate();</p>
<p>      // Add empty cells for days before month starts<br />
      for (let i = 0; i < startDate; i++) {
        const emptyDay = document.createElement("div");
        calendarGrid.appendChild(emptyDay);
      }

      // Compute "today" at midnight for reliable comparisons (local timezone)
      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()); // midnight today

      // Add day buttons
      for (let day = 1; day <= daysInMonth; day++) {
        const dayButton = document.createElement("button");
        dayButton.className = "bmt-day-button";
        dayButton.textContent = day;
        dayButton.setAttribute(
          "aria-label",
          `Select ${day} ${monthNames[this.currentMonth.getMonth()]} ${this.currentMonth.getFullYear()}`,
        );

        // Build the full date for this cell (midnight)
        const cellDate = new Date(
          this.currentMonth.getFullYear(),
          this.currentMonth.getMonth(),
          day,
        );

        // If cellDate is before today -> disable it (past date)<br />
        if (cellDate < today) {
          dayButton.disabled = true;
          // Optional: add a class if you want a specific style for disabled days
          dayButton.classList.add("disabled");
        } else {
          // available or future dates
          dayButton.classList.add("available");
        }

        // If the currently-selected date is now in the past, clear it
        if (this.selectedDate) {
          // selectedDate is stored like "30 October 2025" in widget -> attempt to parse<br />
          const selParts = String(this.selectedDate).trim().split(" ");<br />
          // Expect format: [day, Month, Year] or maybe different – handle gracefully<br />
          if (selParts.length >= 3) {<br />
            const selDay = parseInt(selParts[0], 10);<br />
            const selMonthName = selParts[1];<br />
            const selYear = parseInt(selParts[2], 10);<br />
            const selMonthIndex = monthNames.findIndex(<br />
              (m) => m.toLowerCase() === selMonthName.toLowerCase(),<br />
            );<br />
            if (<br />
              !Number.isNaN(selDay) &&<br />
              selMonthIndex >= 0 &&<br />
              !Number.isNaN(selYear)<br />
            ) {<br />
              const selectedDateObj = new Date(selYear, selMonthIndex, selDay);<br />
              if (selectedDateObj < today) {
                // clear invalid selection
                this.selectedDate = null;
                // also remove any selected class visually
                document
                  .querySelectorAll(".bmt-day-button.selected")
                  .forEach((s) => s.classList.remove("selected"));<br />
                // ensure booking state updates<br />
                this.updateBookingState();<br />
              }<br />
            }<br />
          }<br />
        }</p>
<p>        // Handle day selection (only for enabled days)<br />
        dayButton.addEventListener("click", () => {<br />
          if (!dayButton.disabled) {<br />
            document<br />
              .querySelectorAll(".bmt-day-button")<br />
              .forEach((btn) => btn.classList.remove("selected"));<br />
            dayButton.classList.add("selected");<br />
            this.selectedDate = `${day} ${monthNames[this.currentMonth.getMonth()]} ${this.currentMonth.getFullYear()}`;<br />
            this.updateBookingState();<br />
          }<br />
        });</p>
<p>        calendarGrid.appendChild(dayButton);<br />
      }<br />
    }</p>
<p>    // ===== FEATURE START: Person count controls and pricing sync =====<br />
    updatePersonCount() {<br />
