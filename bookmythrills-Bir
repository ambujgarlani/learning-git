          padding: 20px;
          margin-bottom: 16px;
        }
        
        .bmt-datetime-grid {
          grid-template-columns: 1fr;
          gap: 24px;
        }
        
        .bmt-package-grid {
          grid-template-columns: 1fr;
          gap: 20px;
        }
        
        .bmt-package-card {
          padding: 16px;
