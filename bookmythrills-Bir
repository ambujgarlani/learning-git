      }

      .bmt-feature-icon.reschedule {
        background: linear-gradient(135deg, ${BRAND_PRIMARY} 0%, ${BRAND_HOVER} 100%);
      }

      .bmt-feature-icon.insurance {
        background: linear-gradient(135deg, ${BRAND_PRIMARY} 0%, ${BRAND_HOVER} 100%);
      }

      .bmt-feature-icon.booking {
        background: linear-gradient(135deg, ${BRAND_PRIMARY} 0%, ${BRAND_HOVER} 100%);
