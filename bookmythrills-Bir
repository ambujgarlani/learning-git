        text-align: right;
      }

      .bmt-mobile-savings-info {
        text-align: center;
        margin-bottom: 6px;
      }

      .bmt-mobile-savings-amount {
        color: #28a745;
        font-size: 12px;
        font-weight: 600;
      }

      .bmt-mobile-original-price {
        color: #999;
        font-size: 11px;
        text-decoration: line-through;
        margin-left: 6px;
      }

      .bmt-mobile-price-details {
        text-align: center;
        margin-bottom: 6px;
      }

      .bmt-mobile-price-details small {
        color: #666;
        font-size: 10px;
        line-height: 1.3;
      }

