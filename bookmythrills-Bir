        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 14px;
      }

      .bmt-summary-label {
        color: #666;
      }

      .bmt-summary-value {
        font-weight: 500;
      }

      .bmt-summary-price {
        font-size: 20px;
        font-weight: 700;
        color: ${BRAND_PRIMARY};
        text-align: right;
        margin: 16px 0 8px 0;
      }

      .bmt-savings-info {
        text-align: right;
        margin-bottom: 8px;
      }

      .bmt-savings-amount {
        color: #28a745;
        font-size: 13px;
        font-weight: 600;
      }

      .bmt-original-price {
        color: #999;
        font-size: 12px;
        text-decoration: line-through;
        margin-left: 8px;
      }

      .bmt-price-details {
        text-align: right;
        margin-bottom: 16px;
      }

      .bmt-price-details small {
        color: #666;
        font-size: 11px;
        line-height: 1.3;
      }

      .bmt-promo-section {
        margin: 20px 0;
        padding-top: 20px;
        border-top: 1px solid rgba(17,17,17,0.08);
      }

