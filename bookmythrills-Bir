        background: white;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 16px;
        font-weight: 600;
        transition: all 0.2s;
      }

      .bmt-person-btn:hover:not(:disabled) {
        border-color: ${BRAND_PRIMARY};
        background: #fafbfc;
      }

      .bmt-person-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .bmt-person-count {
        font-weight: 600;
        font-size: 16px;
        min-width: 24px;
        text-align: center;
      }

      /* Mobile Styles */
      .bmt-mobile-sticky-bar {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        border-top: 1px solid rgba(17,17,17,0.08);
        padding: 12px 16px;
        box-shadow: 0 -1px 4px rgba(0,0,0,0.05);
        z-index: 1000;
      }

      .bmt-mobile-summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        font-size: 14px;
      }

      .bmt-mobile-details {
        font-weight: 500;
        flex: 1;
      }

      .bmt-mobile-price {
        font-weight: 700;
        color: ${BRAND_PRIMARY};
