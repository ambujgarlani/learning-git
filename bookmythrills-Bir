        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: white;
        border: 1px solid rgba(17,17,17,0.12);
        border-radius: 6px;
        padding: 8px 16px;
        min-height: 40px;
        white-space: nowrap;
        cursor: pointer;
        font-size: 14px;
      }

      .bmt-apply-btn:hover {
        background: #f5f5f5;
      }

      .bmt-book-now-btn {
        width: 100%;
        background: ${BRAND_PRIMARY};
        color: white;
        border: none;
        border-radius: 8px;
        padding: 16px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
      }

      .bmt-book-now-btn:hover:not(:disabled) {
        background: ${BRAND_HOVER};
      }

      .bmt-book-now-btn:focus {
        outline: 2px solid ${BRAND_PRIMARY};
        outline-offset: 2px;
      }

      .bmt-book-now-btn:disabled {
        background: #ccc;
        cursor: not-allowed;
      }

