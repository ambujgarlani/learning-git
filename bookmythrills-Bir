  <script>
    function switchTab(tabId, buttonElement) {
        // Remove active class from all tabs and buttons
        const allTabs = document.querySelectorAll('.tab-content');
        const allButtons = document.querySelectorAll('.tab-button');
        
        allTabs.forEach(tab => {
            tab.classList.remove('active');
        });
        
        allButtons.forEach(button => {
            button.classList.remove('active');
        });
        
        // Add active class to selected tab and button
        document.getElementById(tabId).classList.add('active');
        buttonElement.classList.add('active');
    }

    function toggleAccordion(accordionId) {
        const accordionSection = document.getElementById(accordionId).parentElement;
        const isActive = accordionSection.classList.contains('active');
        
        // Close all accordion sections
        const allAccordions = document.querySelectorAll('.accordion-section');
        allAccordions.forEach(accordion => {
            accordion.classList.remove('active');
        });
        
        // If the clicked accordion wasn't active, open it
        if (!isActive) {
            accordionSection.classList.add('active');
        }
