      }

      .bmt-feature-icon svg {
        width: 16px;
        height: 16px;
        fill: white;
      }

      .bmt-feature-icon.safety {
        background: linear-gradient(135deg, ${BRAND_PRIMARY} 0%, ${BRAND_HOVER} 100%);
      }

      .bmt-feature-icon.expert {
        background: linear-gradient(135deg, ${BRAND_PRIMARY} 0%, ${BRAND_HOVER} 100%);
      }

