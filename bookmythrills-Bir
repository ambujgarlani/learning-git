        padding: 8px 12px;
        border: 1px solid rgba(17,17,17,0.12);
        border-radius: 6px;
        font-size: 14px;
      }

      .bmt-promo-input input:focus {
        outline: 2px solid ${BRAND_PRIMARY};
        outline-offset: 2px;
        border-color: ${BRAND_PRIMARY};
      }

