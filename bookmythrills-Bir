  bindEvents() {
    // Calendar navigation
    document.getElementById('bmt-prev-month').addEventListener('click', () => {
      this.currentMonth.setMonth(this.currentMonth.getMonth() - 1);
      this.updateCalendar();
    });

    document.getElementById('bmt-next-month').addEventListener('click', () => {
      this.currentMonth.setMonth(this.currentMonth.getMonth() + 1);
      this.updateCalendar();
    });

    // Time slot selection
    document.getElementById('bmt-time-slots').addEventListener('click', (e) => {
      if (e.target.classList.contains('bmt-time-slot')) {
        document.querySelectorAll('.bmt-time-slot').forEach(slot => slot.classList.remove('selected'));
        e.target.classList.add('selected');
        this.selectedTime = e.target.dataset.time;
        this.updateBookingState();
      }
    });

    // Package selection
    document.getElementById('bmt-package-grid').addEventListener('click', (e) => {
      const packageCard = e.target.closest('.bmt-package-card');
      if (packageCard) {
        document.querySelectorAll('.bmt-package-card').forEach(card => card.classList.remove('selected'));
        packageCard.classList.add('selected');
        this.selectedPackage = packageCard.dataset.package;
        this.updateBookingState();
      }
    });

    // Package keyboard navigation
    document.getElementById('bmt-package-grid').addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const packageCard = e.target.closest('.bmt-package-card');
        if (packageCard) {
          packageCard.click();
        }
      }
    });

    // Promo code
    document.getElementById('bmt-apply-promo').addEventListener('click', () => {
      const promoInput = document.getElementById('bmt-promo-input');
      this.promoCode = promoInput.value;
      // Mock promo code application
      if (this.promoCode) {
        alert('Promo code applied! (This is a demo)');
      }
    });

    // Person selector
    document.getElementById('bmt-decrease-persons').addEventListener('click', () => {
      if (this.personCount > 1) {
        this.personCount--;
        this.updatePersonCount();
        this.updateBookingState();
      }
    });

    document.getElementById('bmt-increase-persons').addEventListener('click', () => {
      this.personCount++;
      this.updatePersonCount();
      this.updateBookingState();
    });

    // Mobile person selector
    document.getElementById('bmt-mobile-decrease-persons').addEventListener('click', () => {
      if (this.personCount > 1) {
        this.personCount--;
        this.updatePersonCount();
        this.updateBookingState();
      }
    });

    document.getElementById('bmt-mobile-increase-persons').addEventListener('click', () => {
      this.personCount++;
      this.updatePersonCount();
      this.updateBookingState();
    });

    // Book now buttons
    // ---- REPLACED bookNowHandler START ----
    // This handler will POST to WC AJAX add_to_cart with bmt_booking JSON and fallback to redirect.
    const WC_PRODUCT_ID = 1144; // <-- your Paragliding product ID

    const bookNowHandler = async (e) => {
      if (!(this.selectedDate && this.selectedTime && this.selectedPackage)) {
        alert('Please select date, time and package before proceeding.');
        return;
      }

      const selectedPkg = PACKAGES.find(pkg => pkg.id === this.selectedPackage);
      const booking = {
        product_name: 'Paragliding in Bir Billing',
        source: 'paragliding-in-bir-billing-widget',
        date: this.selectedDate,
        time: this.selectedTime,
        package_id: this.selectedPackage,
        package_name: selectedPkg ? selectedPkg.name : this.selectedPackage,
        unit_price: selectedPkg ? selectedPkg.price : 0, // per person
        persons: this.personCount || 1,
      };
      booking.total_price = (booking.unit_price || 0) * Math.max(1, booking.persons);

      // Build form data for WC AJAX
      const form = new FormData();
      form.append('product_id', String(WC_PRODUCT_ID));
      // send quantity as persons (PHP will handle price override)
      form.append('quantity', String(Math.max(1, booking.persons)));
      form.append('bmt_booking', JSON.stringify(booking));
      form.append('bmt_source', booking.source);

      try {
        const resp = await fetch('/?wc-ajax=add_to_cart', {
          method: 'POST',
          credentials: 'same-origin',
          body: form
        });

        if (resp && resp.ok) {
          // success — redirect to checkout with booking query string (keeps UX consistent)
          const qs = new URLSearchParams({
            date: booking.date,
            time: booking.time,
            package: booking.package_name,
            price: String(booking.total_price),
            persons: String(booking.persons)
          }).toString();

          window.location.href = `${CHECKOUT_URL}?${qs}`;
          return;
        }
      } catch (err) {
        console.warn('Add to cart via AJAX failed:', err);
      }

      // fallback redirect (if AJAX blocked)
      const fallbackQS = new URLSearchParams({
        date: booking.date,
        time: booking.time,
        package: booking.package_name,
        price: String(booking.total_price),
        persons: String(booking.persons)
      }).toString();

      window.location.href = `${CHECKOUT_URL}?${fallbackQS}`;
    };
    // ---- REPLACED bookNowHandler END ----

    document.getElementById('bmt-book-now').addEventListener('click', bookNowHandler);
    document.getElementById('bmt-mobile-book-now').addEventListener('click', bookNowHandler);
  }

    updateCalendar() {
    const monthYear = document.getElementById('bmt-month-year');
    const calendarGrid = document.getElementById('bmt-calendar-grid');

    // Update month/year display
    const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'];
    monthYear.textContent = `${monthNames[this.currentMonth.getMonth()]} ${this.currentMonth.getFullYear()}`;

    // Clear existing days (keep headers)
    const dayButtons = calendarGrid.querySelectorAll('.bmt-day-button');
    dayButtons.forEach(btn => btn.remove());

    // Get first day of month and number of days
    const firstDay = new Date(this.currentMonth.getFullYear(), this.currentMonth.getMonth(), 1);
    const lastDay = new Date(this.currentMonth.getFullYear(), this.currentMonth.getMonth() + 1, 0);
    const startDate = firstDay.getDay(); // 0 = Sunday
    const daysInMonth = lastDay.getDate();

    // Add empty cells for days before month starts
    for (let i = 0; i < startDate; i++) {
      const emptyDay = document.createElement('div');
      calendarGrid.appendChild(emptyDay);
    }

    // Compute "today" at midnight for reliable comparisons (local timezone)
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()); // midnight today

    // Add day buttons
    for (let day = 1; day <= daysInMonth; day++) {
      const dayButton = document.createElement('button');
      dayButton.className = 'bmt-day-button';
      dayButton.textContent = day;
      dayButton.setAttribute('aria-label', `Select ${day} ${monthNames[this.currentMonth.getMonth()]} ${this.currentMonth.getFullYear()}`);

      // Build the full date for this cell (midnight)
      const cellDate = new Date(this.currentMonth.getFullYear(), this.currentMonth.getMonth(), day);

      // If cellDate is before today -> disable it (past date)
      if (cellDate < today) {
        dayButton.disabled = true;
        // Optional: add a class if you want a specific style for disabled days
        dayButton.classList.add('disabled');
      } else {
        // available or future dates
        dayButton.classList.add('available');
      }

      // If the currently-selected date is now in the past, clear it
      if (this.selectedDate) {
        // selectedDate is stored like "30 October 2025" in widget -> attempt to parse
        const selParts = String(this.selectedDate).trim().split(' ');
        // Expect format: [day, Month, Year] or maybe different – handle gracefully
        if (selParts.length >= 3) {
          const selDay = parseInt(selParts[0], 10);
          const selMonthName = selParts[1];
          const selYear = parseInt(selParts[2], 10);
          const selMonthIndex = monthNames.findIndex(m => m.toLowerCase() === selMonthName.toLowerCase());
          if (!Number.isNaN(selDay) && selMonthIndex >= 0 && !Number.isNaN(selYear)) {
            const selectedDateObj = new Date(selYear, selMonthIndex, selDay);
            if (selectedDateObj < today) {
              // clear invalid selection
              this.selectedDate = null;
              // also remove any selected class visually
              document.querySelectorAll('.bmt-day-button.selected').forEach(s => s.classList.remove('selected'));
              // ensure booking state updates
              this.updateBookingState();
            }
          }
        }
      }

      // Handle day selection (only for enabled days)
      dayButton.addEventListener('click', () => {
        if (!dayButton.disabled) {
          document.querySelectorAll('.bmt-day-button').forEach(btn => btn.classList.remove('selected'));
          dayButton.classList.add('selected');
          this.selectedDate = `${day} ${monthNames[this.currentMonth.getMonth()]} ${this.currentMonth.getFullYear()}`;
          this.updateBookingState();
        }
      });

      calendarGrid.appendChild(dayButton);
    }
  }

  updatePersonCount() {
    document.getElementById('bmt-person-count').textContent = this.personCount;
    document.getElementById('bmt-mobile-person-count').textContent = this.personCount;
    
    // Disable decrease buttons if at minimum
    const decreaseBtn = document.getElementById('bmt-decrease-persons');
    const mobileDecreaseBtn = document.getElementById('bmt-mobile-decrease-persons');
    decreaseBtn.disabled = this.personCount <= 1;
    mobileDecreaseBtn.disabled = this.personCount <= 1;
  }

  updateBookingState() {
    // Update summary
    document.getElementById('bmt-summary-date').textContent = this.selectedDate || 'Not selected';
    document.getElementById('bmt-summary-time').textContent = this.selectedTime || 'Not selected';
    
    let packageName = 'Not selected';
    let packagePrice = 0;
    let originalPrice = 0;
    let savings = 0;
    
    if (this.selectedPackage) {
      const selectedPkg = PACKAGES.find(pkg => pkg.id === this.selectedPackage);
      packageName = selectedPkg.name;
      packagePrice = selectedPkg.price * this.personCount;
      originalPrice = selectedPkg.originalPrice * this.personCount;
      savings = originalPrice - packagePrice;
    }
    
    document.getElementById('bmt-summary-package').textContent = packageName;
    document.getElementById('bmt-summary-price').textContent = `₹${packagePrice.toLocaleString()}`;
    
    // Update savings info
    const savingsInfo = document.getElementById('bmt-savings-info');
    const mobileSavingsInfo = document.getElementById('bmt-mobile-savings-info');
    if (this.selectedPackage && savings > 0) {
      document.getElementById('bmt-savings-amount').textContent = `You save ₹${savings.toLocaleString()}`;
      document.getElementById('bmt-original-price').textContent = `₹${originalPrice.toLocaleString()}`;
      document.getElementById('bmt-mobile-savings-amount').textContent = `You save ₹${savings.toLocaleString()}`;
      document.getElementById('bmt-mobile-original-price').textContent = `₹${originalPrice.toLocaleString()}`;
      savingsInfo.style.display = 'block';
      mobileSavingsInfo.style.display = 'block';
    } else {
      savingsInfo.style.display = 'none';
      mobileSavingsInfo.style.display = 'none';
    }
    
    // Update mobile bar
    const mobileDetails = document.getElementById('bmt-mobile-details');
    const mobilePrice = document.getElementById('bmt-mobile-price');
    
    if (this.selectedDate && this.selectedPackage) {
      const personText = this.personCount > 1 ? ` • ${this.personCount} persons` : '';
      mobileDetails.textContent = `${this.selectedDate.split(' ')[0]} ${this.selectedDate.split(' ')[1]} • ${packageName.split(' ')[0]}${personText}`;
      mobilePrice.textContent = `₹${packagePrice.toLocaleString()}`;
    } else {
      mobileDetails.textContent = 'Select date & package';
      mobilePrice.textContent = '₹0';
    }
    
    // Enable/disable book now buttons
    const canBook = this.selectedDate && this.selectedTime && this.selectedPackage;
    document.getElementById('bmt-book-now').disabled = !canBook;
    document.getElementById('bmt-mobile-book-now').disabled = !canBook;
  }
}

// Initialize the widget when DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => new BookingWidget());
} else {
  new BookingWidget();
}
</script>

